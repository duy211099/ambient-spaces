<main class="stage" data-scene="cafe-rain">
  <canvas
    id="scene-canvas"
    class="stage__canvas"
    role="img"
    aria-label="Illustrated cafe by a rainy window. Click rain, crowd, espresso machine or radio to adjust its sound."
  >
  </canvas>
  <div id="controls" class="controls"></div>
  <noscript>
    <p class="stage__noscript">Living Ambience needs JavaScript to draw the scene and play sound.</p>
  </noscript>
</main>
